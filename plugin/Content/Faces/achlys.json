{"key":"achlys","name":"Achlys","accent":"#bcd4ff","based":"Mesa/Boogie Mark IV","intro":"Achlys is new: a blacked-out Mark IV-style head in smooth matte black. It has black-on-black cloth, black knobs, grey print and only a faint cold-white light. CHANNEL picks R1, R2 or Lead, like the Mark IV's three channels, and VOICE steps through the captures in that channel (2, 2 and 5).","notes":["All nine captures are used, and all are amp only.","On R1 and R2 Gain drives the capture. On Lead it's Lead drive, as on the real amp.","The lead voices include the graphic-EQ-on versions and one with the presence pulled, so you get Mark IV EQ moves without modelling them."],"W":1800,"H":900,"skins":[{"id":"achlys","ptrOff":false}],"knobs":[{"label":"Gain","b":[226,683,85,85],"o":[49.918,49.541],"c":[268.4,725.1],"r":33.1,"v":0.55},{"label":"Treble","b":[412,683,85,85],"o":[49.624,49.541],"c":[454.2,725.1],"r":33.1,"v":0.6},{"label":"Bass","b":[597,683,85,85],"o":[50.518,49.541],"c":[639.9,725.1],"r":33.1,"v":0.4},{"label":"Middle","b":[783,683,85,85],"o":[50.235,49.541],"c":[825.7,725.1],"r":33.1,"v":0.5},{"label":"Presence","b":[969,683,85,85],"o":[49.941,49.541],"c":[1011.5,725.1],"r":33.1,"v":0.5},{"label":"Lead drive","b":[1155,683,85,85],"o":[49.659,49.541],"c":[1197.2,725.1],"r":33.1,"v":0.65},{"label":"Master","b":[1340,683,85,85],"o":[50.553,49.541],"c":[1383.0,725.1],"r":33.1,"v":0.45}],"leds":{"ch1":[1466,682,20,19],"ch2":[1479,682,20,19],"ch3":[1491,682,20,19],"vo1":[1533,682,19,19],"vo2":[1541,682,19,19],"vo3":[1549,682,19,19],"vo4":[1557,682,19,19],"vo5":[1566,682,18,19]},"buttons":{"channel":[1472.2,710.8,36.9,25.1],"voice":[1542.4,710.8,36.9,25.1]},"power":[1644.6,723.0,26.5],"dims":[{"id":"channel","names":["R1 · clean","R2 · rhythm","Lead"],"button":"channel","leds":[["ch1"],["ch2"],["ch3"]],"perknobs":[0,1,2,3,6],"start":2},{"id":"voice","button":"voice","leds":[["vo1"],["vo2"],["vo3"],["vo4"],["vo5"]],"per":"channel"}],"switches":[],"caps":{"0|0":{"name":"Bright