{"key":"typhon","name":"Typhon","accent":"#e8e8ee","based":"EVH 5150 III Stealth 100W","intro":"Typhon is new, in the spirit of the 5150 III Stealth: all matte black, with a 3D pyramid grid across the front and glossy black stripes criss-crossing it like tape. The stripes only show when the light catches them. GREEN, BLUE and RED pick the three channels, and the light strip and power lamp change to that channel's colour.","notes":["One capture per channel, all through a Mesa Oversized 4x12 (full rig), so the plugin's cab is bypassed on this amp.","The green capture was made with an SD-1 in front, so it's already pushed. Blue and red are the amp on its own.","Gain drives the input into each capture. Each channel remembers its own Gain, Volume and EQ, like the real amp."],"W":1800,"H":900,"skins":[{"id":"typhon_green","ptrOff":false},{"id":"typhon_blue","ptrOff":false},{"id":"typhon_red","ptrOff":false}],"knobs":[{"label":"Gain","b":[226,683,85,85],"o":[49.918,49.541],"c":[268.4,725.1],"r":33.1,"v":0.75},{"label":"Volume","b":[412,683,85,85],"o":[49.624,49.541],"c":[454.2,725.1],"r":33.1,"v":0.5},{"label":"Low","b":[597,683,85,85],"o":[50.518,49.541],"c":[639.9,725.1],"r":33.1,"v":0.45},{"label":"Mid","b":[783,683,85,85],"o":[50.235,49.541],"c":[825.7,725.1],"r":33.1,"v":0.55},{"label":"High","b":[969,683,85,85],"o":[49.941,49.541],"c":[1011.5,725.1],"r":33.1,"v":0.5},{"label":"Presence","b":[1155,683,85,85],"o":[49.659,49.541],"c":[1197.2,725.1],"r":33.1,"v":0.55},{"label":"Resonance","b":[1340,683,85,85],"o":[50.553,49.541],"c":[1383.0,725.1],"r":33.1,"v":0.5}],"leds":{"ch1_led":[1460,690,21,21],"ch2_led":[1519,690,21,21],"ch3_led":[1578,690,20,21]},"buttons":{"ch1":[1455.3,711.6,34.0,23.6],"ch2":[1514.3,711.6,34.0,23.6],"ch3":[1573.4,711.6,34.0,23.6]},"power":[1659.3,723.0,26.5],"dims":[{"id":"channel","names":["Green","Blue","Red"],"buttons":["ch1","ch2","ch3"],"leds":[["ch1_led"],["ch2_led"],["ch3_led"]],"skin":true,"perknobs":[0,1,2,3,4],"start":2}],"switches":[