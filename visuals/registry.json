 "pedals": {
  "abyss": {
   "name": "Abyss",
   "spec": "pedals/abyss.json",
   "type": "octave"
  },
  "aeon": {
   "name": "Aeon",
   "spec": "pedals/aeon.json",
   "type": "bass/guitar drive, wide enclosure",
   "inspired_by": "Darkglass Alpha Omega Ultra",
   "engine": "pack pedal (captures in Documents/Obsidian Suite/Captures/Pedals/Aeon)",
   "knobs": {
    "Blend": "Mix",
    "Level": "Output",
    "Drive": "capture gain step (0,1,3,5,7,8,10)"
   },
   "switches": {
    "Voice": {
     "α": "Alpha",
     "Ω": "Omega"
    },
    "Growl": "button",
    "Bite": "button",
    "footswitches": [
     "Drive on/off",
     "Bypass"
    ]
   },
   "captures": {
    "count": 56,
    "pattern_alpha": "Alpha-{Neutral|Growl|BITE|Bite-Growl} G{n}.nam",
    "pattern_omega": "Omega - Omega-{Neutral|Growl|BITE|Bite-Growl} G{n}.nam",
    "gain_steps": [
     0,
     1,
     3,
     5,
     7,
     8,
     10
    ],
    "note": "Voice + Growl/Bite buttons + Drive step pick one of the 56 files"
   }
  },
  "ascend": {
   "name": "Ascend",
   "spec": "pedals/ascend.json",
   "type": "pitch / whammy"
  },
  "astral": {
   "name": "Astral",
   "spec": "pedals/astral.json",
   "type": "shimmer delay",
   "engine": "built-in (plugin/Source/DSP/Modules/CelestialModules.cpp)",
   "art": "tools/art_astral.py",
   "face_knobs_in_order": [
    "Time",
    "Feedback",
    "Mix",
    "Shimmer",
    "Diffuse",
    "Mod",
    "Tone",
    "Interval"
   ]
  },
  "aurora": {
   "name": "Aurora",
   "spec": "pedals/aurora.json",
   "type": "ambient swell"
  },
  "bloom": {
   "name": "Bloom",
   "spec": "pedals/bloom.json",
   "type": "envelope filter"
  },
  "chiron": {
   "name": "Chiron",
   "spec": "pedals/chiron.json",
   "type": "transparent overdrive",
   "inspired_by": "Klon Centaur (captures: Behringer Centaur OD)",
   "engine": "pack pedal (captures in Documents/Obsidian Suite/Captures/Pedals/Chiron)",
   "knobs": {
    "Drive": "Input",
    "Blend": "Mix",
    "Output": "Output"
   },
   "switch": {
    "label": "Capture",
    "positions": {
     "MID": "Centaur OD (mid gain).nam",
     "HIGH": "Centaur OD (high gain).nam"
    }
   }
  },
  "crypt": {
   "name": "Crypt",
   "spec": "pedals/crypt.json",
   "type": "reverb",
   "irs": {
    "source": "Boss RV-6 (Boss_RV-6.zip)",
